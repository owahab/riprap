#!/usr/bin/env bash
# riprap — guardrails, conventions, and enforcement for Claude Code projects.
#
# A thin dispatcher. Each subcommand is a standalone script in this directory so
# it stays independently testable; nothing but argument routing lives here.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
riprap — guardrails, conventions, and enforcement for Claude Code projects.

usage:
  riprap install <project>              copy the payload into a project
  riprap update <project>               refresh it, keeping your edits
  riprap contribute <project> <path>... send an improvement back upstream
  riprap check <path>...                scan for content that must not ship

Install writes .riprap-manifest.json, which records what riprap owns. Files are
either "template" (upstream keeps them current) or "seed" (yours the moment they
land, never overwritten).

Docs: https://riprap.dev
USAGE
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install)    exec "$SCRIPT_DIR/install" "$@" ;;
  update)     exec "$SCRIPT_DIR/update" "$@" ;;
  contribute) exec "$SCRIPT_DIR/contribute" "$@" ;;
  check)      exec "$SCRIPT_DIR/scrub-check" "$@" ;;
  ""|-h|--help|help) usage ;;
  --version)  git -C "$SCRIPT_DIR/.." describe --tags --always 2>/dev/null || echo unknown ;;
  *) printf 'riprap: unknown command %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
