#!/usr/bin/env bash
# build-manifest — regenerate template/MANIFEST from what is actually in template/.
#
# The manifest is the allowlist install reads, so it has to match the tree exactly:
# a file present but unlisted never reaches adopters, and a file listed but absent
# makes install die. Keeping it in sync by hand fails silently in both directions,
# so it is generated, and CI checks the generated form matches what is committed.
#
#   bin/build-manifest           rewrite template/MANIFEST
#   bin/build-manifest --check   exit 1 if it is out of date (for CI)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Which files are the project's own from the moment they land. Everything else is
# owned upstream. Keep this list short — a seed file is one riprap can never
# improve for an existing adopter.
is_seed() {
  case "$1" in
    CLAUDE.md|.claude/settings.json|bin/test|bin/lint|bin/format|bin/setup) return 0 ;;
    *) return 1 ;;
  esac
}

generate() {
  cat <<'HDR'
# MANIFEST — the allowlist of record.
#
# Every file riprap installs into a project is named here. Nothing is copied
# because it happens to sit in template/; install reads THIS file and refuses
# anything not listed.
#
# That is deliberate. A recursive copy will happily carry a .pyc, a .DS_Store, or
# an editor backup into someone else's public repo — and a compiled artifact
# embeds absolute source paths and identifiers that no text scrubber can see
# inside.
#
# Two tiers:
#   template  upstream keeps it current; `riprap update` refreshes it unless the
#             project edited it, in which case the conflict is reported.
#   seed      the project's own from the moment it lands; never overwritten.
#
# Generated by bin/build-manifest. Do not hand-edit — CI checks it matches the
# tree, and a hand-edit that drifts fails in whichever direction you did not test.
#
# Format: tier<TAB>path

HDR
  # Deterministic order so the file diffs cleanly.
  (cd template && find . -type f ! -name MANIFEST | sed 's|^\./||' | LC_ALL=C sort) \
  | while IFS= read -r f; do
      if is_seed "$f"; then printf 'seed\t%s\n' "$f"; else printf 'template\t%s\n' "$f"; fi
    done
}

if [ "${1:-}" = "--check" ]; then
  if diff -q <(generate) template/MANIFEST >/dev/null 2>&1; then
    echo "✅ MANIFEST is up to date"
    exit 0
  fi
  echo "❌ MANIFEST does not match template/. Run bin/build-manifest." >&2
  diff <(generate) template/MANIFEST >&2 || true
  exit 1
fi

generate > template/MANIFEST
printf '✅ wrote template/MANIFEST (%d entries)\n' \
  "$(grep -cvE '^[[:space:]]*(#|$)' template/MANIFEST)"
