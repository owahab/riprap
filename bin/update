#!/usr/bin/env bash
# riprap update <project> — refresh the payload without destroying local edits.
#
# The rule that makes this safe: the manifest records the hash of what riprap
# last wrote, so we can tell "unchanged since we wrote it" from "the project
# edited this". Only the former is overwritten. Everything else is reported and
# left alone — an update that silently reverts someone's work is worse than no
# update at all.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

TARGET="${1:-}"
[ -n "$TARGET" ] || die "usage: riprap update <project-directory>"
[ -d "$TARGET" ] || die "no such directory: $TARGET"
TARGET="$(cd "$TARGET" && pwd)"

MANIFEST="$TARGET/.riprap-manifest.json"
[ -f "$MANIFEST" ] || die "not a riprap install (no .riprap-manifest.json) — use 'riprap install'"

require_clean_tree "$TARGET"

FROM=$(sed -n 's/.*"riprap_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST" | head -1)
TO="$(riprap_version "$ROOT")"
printf 'Updating %s\n  from riprap %s\n    to riprap %s\n\n' "$TARGET" "${FROM:-unknown}" "$TO"

applied=0 conflicts=0 seeds=0 added=0
conflict_list="" seed_list=""
records=""

add_record() { records="$records$(printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4")"$'\n'; }

while IFS=$'\t' read -r tier path; do
  [ -n "$path" ] || continue
  src="$ROOT/template/$path"
  dst="$TARGET/$path"
  [ -f "$src" ] || die "MANIFEST lists a missing file: template/$path"

  prev="$(recorded_sha "$MANIFEST" "$path")"

  # Seed files are never touched. Report a difference so the adopter can pull a
  # change in by hand if they want, but the decision stays theirs.
  if [ "$tier" = "seed" ]; then
    if [ -f "$dst" ] && ! cmp -s "$src" "$dst"; then
      seed_list="$seed_list  $path"$'\n'; seeds=$((seeds + 1))
    fi
    add_record "$path" "$tier" "${prev:-$( [ -f "$dst" ] && sha256_of "$dst" || echo '')}" "seed"
    continue
  fi

  if [ ! -f "$dst" ]; then
    mkdir -p "$(dirname "$dst")"; cp "$src" "$dst"; [ -x "$src" ] && chmod +x "$dst"
    printf '  add       %s\n' "$path"; added=$((added + 1))
    add_record "$path" "$tier" "$(sha256_of "$dst")" "installed"; continue
  fi

  if cmp -s "$src" "$dst"; then                      # already current
    add_record "$path" "$tier" "$(sha256_of "$dst")" "current"; continue
  fi

  have="$(sha256_of "$dst")"
  if [ -n "$prev" ] && [ "$prev" != "$have" ]; then
    # The project changed this since we wrote it. Leave it, and keep recording
    # the OLD hash so the conflict keeps being detected on future runs.
    conflict_list="$conflict_list  $path"$'\n'; conflicts=$((conflicts + 1))
    add_record "$path" "$tier" "$prev" "modified-locally"
  else
    cp "$src" "$dst"; [ -x "$src" ] && chmod +x "$dst"
    printf '  update    %s\n' "$path"; applied=$((applied + 1))
    add_record "$path" "$tier" "$(sha256_of "$dst")" "installed"
  fi
done < <(manifest_entries "$ROOT")

printf '%s' "$records" | write_manifest "$TARGET" "$TO"

printf '\n%d updated, %d added, %d left alone.\n' "$applied" "$added" "$((conflicts + seeds))"

if [ "$conflicts" -gt 0 ]; then
  printf '\nYou changed these, so we did not:\n%s' "$conflict_list"
  printf 'To see what upstream changed:  diff <file> %s/template/<file>\n' "$ROOT"
  printf 'If you want ours, delete yours and re-run update.\n'
fi
if [ "$seeds" -gt 0 ]; then
  printf '\nSeed files that differ upstream (yours always win, listed for reference):\n%s' "$seed_list"
fi

[ "$added" -gt 0 ] && printf '\nNew stubs may need configuring: bin/verify-stubs\n'
exit 0
