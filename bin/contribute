#!/usr/bin/env bash
# riprap contribute <project> <path>... — promote a project-side improvement upstream.
#
# This is the direction that keeps riprap alive: an adopting project improves a
# hook or a doc, and the improvement flows back rather than rotting in one repo.
#
# Two refusals are load-bearing:
#   - seed files are never promoted. They are project-specific by definition, and
#     a project's CLAUDE.md is exactly the thing that must not become everyone's.
#   - every file is scrubbed BEFORE it is copied in. An adopting project's names,
#     vendors, and infrastructure must never reach the public template, and the
#     moment of promotion is the only chokepoint where that can be enforced.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

TARGET="${1:-}"; shift || true
[ -n "$TARGET" ] && [ $# -gt 0 ] || die "usage: riprap contribute <project-directory> <path>..."
[ -d "$TARGET" ] || die "no such directory: $TARGET"
TARGET="$(cd "$TARGET" && pwd)"
[ -f "$TARGET/.riprap-manifest.json" ] || die "not a riprap install: $TARGET"

require_clean_tree "$ROOT"

tier_of() {  # $1 = path
  manifest_entries "$ROOT" | awk -F'\t' -v p="$1" '$2 == p { print $1; exit }'
}

# Stage into a scratch dir first so a scrub failure on file 3 of 5 does not
# leave the template half-modified.
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

for path in "$@"; do
  src="$TARGET/$path"
  [ -f "$src" ] || die "no such file in the project: $path"

  tier="$(tier_of "$path")"
  [ -n "$tier" ] || die "$path is not a riprap-owned file — nothing to contribute"
  [ "$tier" != "seed" ] || die "$path is a seed file: it is yours by design and cannot be promoted upstream"

  if [ -s "$src" ] && ! LC_ALL=C grep -Iq . "$src" 2>/dev/null; then
    die "refusing to promote a non-text file: $path"
  fi

  mkdir -p "$STAGE/$(dirname "$path")"
  cp "$src" "$STAGE/$path"
done

printf 'Scrubbing %d file(s) before promotion...\n' "$#"
if ! "$SCRIPT_DIR/scrub-check" --quiet "$STAGE"; then
  die "
Refusing to promote: the scrub found content that must not be published.
Fix it in your project first, then contribute again."
fi

BRANCH="contrib/$(printf '%s' "$1" | tr '/.' '--')-$$"
git -C "$ROOT" checkout -q -b "$BRANCH"

for path in "$@"; do
  cp "$STAGE/$path" "$ROOT/template/$path"
  git -C "$ROOT" add "template/$path"
  printf '  staged  template/%s\n' "$path"
done

printf '\nOn branch %s with your changes staged.\n' "$BRANCH"
printf 'Review, commit, and open a PR:\n\n'
printf '  git -C %s diff --cached\n' "$ROOT"
printf '  git -C %s commit -m "..." && gh pr create\n\n' "$ROOT"
printf 'If this was a mistake:  git -C %s checkout - && git -C %s branch -D %s\n' \
  "$ROOT" "$ROOT" "$BRANCH"
