#!/usr/bin/env bash
# verify-stubs — report which bin/ stubs are still unconfigured.
#
# Informational by default (always exits 0) so it is useful on a fresh install.
# --strict exits non-zero, for projects that have finished adopting and want it
# as a CI gate.
set -euo pipefail

cd "$(git rev-parse --show-toplevel 2>/dev/null || echo .)"

STRICT=0
[ "${1:-}" = "--strict" ] && STRICT=1

STUBS="test lint format setup"
pending=""
missing=""

for s in $STUBS; do
  f="bin/$s"
  if [ ! -f "$f" ]; then
    # Report rather than skip. Silently treating an absent stub as "fine" is how
    # you end up with a pre-push hook that has quietly never run anything.
    missing="$missing $s"
  elif grep -q '^# riprap:stub$' "$f" 2>/dev/null; then
    pending="$pending $s"
  fi
done

if [ -z "$pending" ] && [ -z "$missing" ]; then
  echo "✅ all stubs configured"
  exit 0
fi

if [ -n "$pending" ]; then
  echo "Unconfigured stubs:"
  for s in $pending; do
    printf '  bin/%-8s %s\n' "$s" "$(sed -n '2s/^# bin\/[a-z]* — //p' "bin/$s")"
  done
  echo ""
  echo "Each file carries examples for common ecosystems. Edit it, then delete"
  echo "the line reading '# riprap:stub'."
fi

if [ -n "$missing" ]; then
  [ -n "$pending" ] && echo ""
  echo "Missing entirely — nothing will call these:"
  for s in $missing; do printf '  bin/%s\n' "$s"; done
  echo ""
  echo "Run 'riprap update <this-project>' from your riprap checkout to restore them."
fi

[ "$STRICT" -eq 1 ] && exit 1
exit 0
