#!/usr/bin/env bash
# Git pre-commit hook. Installed by bin/setup via core.hooksPath.
#
# Two jobs: auto-fix what a linter can fix, then run the pattern guardrails
# against what is actually being committed.
#
# Exit codes here are git's convention (1 = reject the commit), NOT the Claude
# hook convention (2 = block the tool call). Same libraries, different callers —
# which is the entire point of keeping the patterns in bin/hooks/lib.
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- 1. Lint and re-stage --------------------------------------------------
# --diff-filter=ACM skips deletions: there is nothing to lint in a file that is
# going away, and passing one to a linter is just an error.
#
# Read into an array with -z (NUL-delimited) rather than splitting a string.
# Filenames with spaces are rare, and a hook that mangles them is the kind of
# bug that surfaces once, confusingly, long after anyone remembers this code.
STAGED=()
while IFS= read -r -d '' f; do
  STAGED+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z || true)

if [ ${#STAGED[@]} -gt 0 ] && [ -x bin/lint ] && ! grep -q '^# riprap:stub$' bin/lint 2>/dev/null; then
  if ! bin/lint "${STAGED[@]}"; then
    echo "❌ bin/lint failed. Fix the issues, or commit with --no-verify to skip." >&2
    exit 1
  fi
  # Re-stage whatever the linter fixed, so the commit contains the fixed form.
  for f in "${STAGED[@]}"; do
    [ -f "$f" ] && git add -- "$f"
  done
  echo "✅ lint passed"
fi

# --- 2. Pattern guardrails -------------------------------------------------
# Each rule is registered once here. Adding a guardrail is: write the library,
# write the Claude hook, add one line below.
#
# Scanning strategy per rule matters:
#   - added lines only  -> pre-existing violations do not block unrelated work
#   - whole file        -> needed for co-occurrence and proximity rules
# Secrets use added-lines-only: a secret already committed is a rotation
# problem, not a reason to block today's unrelated commit.

# shellcheck source=../lib/hook-common.sh
. "$REPO_ROOT/bin/hooks/lib/hook-common.sh"
# shellcheck source=../lib/secret-patterns.sh
. "$REPO_ROOT/bin/hooks/lib/secret-patterns.sh"

FAILED=0

# -- secret hygiene: file-level --
for f in "${STAGED[@]}"; do
  if secret_env_file_path "$f"; then
    echo "❌ Refusing to commit a secret-bearing file: $f" >&2
    echo "   Add it to .gitignore. Commit a .example instead." >&2
    FAILED=1
  fi
done

# -- secret hygiene: token values in added lines --
ADDED=$(git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' || true)
if [ -n "$ADDED" ]; then
  HITS=$(secret_scan_text "$ADDED" || true)
  if [ -n "$HITS" ]; then
    {
      echo "❌ Secret token in staged changes (value redacted):"
      echo ""
      echo "$HITS"
      echo ""
      echo "   Remove it and rotate the credential — it is in your reflog either way."
      echo "   If this is a documented example, add 'lint-ok:secrets' to the line."
    } >&2
    FAILED=1
  fi
fi
[ "$FAILED" -eq 0 ] && echo "✅ secret hygiene passed"

# -- your rules go here --
# . "$REPO_ROOT/bin/hooks/lib/example-patterns.sh"
# for f in "${STAGED[@]}"; do
#   example_relevant_extension "$f" || continue
#   example_path_allowed "$f" && continue
#   [ -f "$f" ] || continue
#   HITS=$(example_scan_text "$(cat "$f")" || true)
#   [ -n "$HITS" ] && { echo "❌ <rule> violation in $f:" >&2; echo "$HITS" >&2; FAILED=1; }
# done

if [ "$FAILED" -ne 0 ]; then
  echo "" >&2
  echo "Commit rejected. Use --no-verify to override, sparingly — bypassing a" >&2
  echo "hook defeats the reason it exists." >&2
  exit 1
fi

exit 0
