# MANIFEST — the allowlist of record.
#
# Every file riprap installs into a project is named here. Nothing is copied
# because it happens to sit in template/; install reads THIS file and refuses
# anything not listed, and CI checks the two agree in both directions.
#
# That is deliberate. A recursive copy will happily carry a .pyc, a .DS_Store,
# or an editor backup into someone else's public repo — and a compiled artifact
# embeds absolute source paths and hardcoded identifiers that no text scrubber
# can see inside.
#
# Two tiers:
#   template  upstream keeps it current; `riprap update` refreshes it unless the
#             project edited it, in which case the conflict is reported.
#   seed      the project's own from the moment it lands; never overwritten.
#
# Format: tier<TAB>path

# --- the project describes itself -----------------------------------
seed	CLAUDE.md
seed	.claude/settings.json

# --- stack seam: hooks and CI call these, so they never learn your stack ---
seed	bin/test
seed	bin/lint
seed	bin/format
seed	bin/setup

# --- guardrails ------------------------------------------------------
template	bin/hooks/claude/block-destructive-outside-cwd.sh
template	bin/hooks/claude/block-unreviewed-merge.sh
template	bin/hooks/claude/format-on-write.sh
template	bin/hooks/claude/lint-example.sh
template	bin/hooks/claude/lint-secrets.sh
template	bin/hooks/claude/session-end.sh
template	bin/hooks/git/pre-commit
template	bin/hooks/git/pre-push
template	bin/hooks/lib/example-patterns.sh
template	bin/hooks/lib/hook-common.sh
template	bin/hooks/lib/merge-gate-patterns.sh
template	bin/hooks/lib/secret-patterns.sh
template	bin/hooks/tests/test-block-destructive-outside-cwd.sh
template	bin/hooks/tests/test-block-unreviewed-merge.sh
template	bin/hooks/tests/test-lint-secrets.sh
template	bin/hooks/tests/test-support.sh
template	bin/verify-stubs
template	bin/verify-hook-wiring

# --- conventions and skills ------------------------------------------
template	.claude/instructions/handovers.md
template	.claude/skills/learn/SKILL.md
template	.claude/skills/spec/SKILL.md

# --- working directories ---------------------------------------------
template	docs/.gitkeep
template	tmp/.gitignore
template	tmp/handover/.gitignore
template	tmp/tasks/.gitignore
